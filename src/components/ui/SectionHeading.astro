---
interface Props {
  eyebrow?: string;
  title: string;
}
const { eyebrow, title } = Astro.props;
---

<div class="mb-8">
  {
    eyebrow && (
      <p class="mb-2 text-xs font-semibold tracking-[0.12em] text-[var(--c-accent-text)] uppercase">
        {eyebrow}
      </p>
    )
  }
  <h2 class="text-3xl font-extrabold sm:text-4xl">{title}</h2>
  <slot />
</div>
