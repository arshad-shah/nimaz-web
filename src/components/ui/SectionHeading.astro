---
interface Props {
  eyebrow?: string;
  title: string;
  as?: 'h1' | 'h2';
}
const { eyebrow, title, as: Tag = 'h2' } = Astro.props;
---

<div class="mb-8">
  {
    eyebrow && (
      <p class="mb-2 text-xs font-semibold tracking-[0.12em] text-[var(--c-accent-text)] uppercase">
        {eyebrow}
      </p>
    )
  }
  <Tag class="text-3xl font-extrabold sm:text-4xl">{title}</Tag>
  <slot />
</div>
