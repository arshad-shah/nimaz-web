---
interface Tab {
  id: string;
  label: string;
}
interface Props {
  tabs: Tab[];
}
const { tabs } = Astro.props;

const panels = await Promise.all(tabs.map((t) => Astro.slots.render(t.id)));
---

<div class="js-tabs">
  <div role="tablist" class="flex flex-wrap gap-2">
    {
      tabs.map((t, i) => (
        <button
          role="tab"
          id={`tab-${t.id}`}
          aria-controls={`panel-${t.id}`}
          aria-selected={i === 0}
          tabindex={i === 0 ? 0 : -1}
          class="rounded-full border border-[var(--outline)] px-4 py-2 text-sm font-semibold aria-selected:bg-[var(--c-primary)] aria-selected:text-[var(--on-primary)]"
        >
          {t.label}
        </button>
      ))
    }
  </div>
  <div class="mt-6">
    {
      tabs.map((t, i) => (
        <div
          role="tabpanel"
          id={`panel-${t.id}`}
          aria-labelledby={`tab-${t.id}`}
          hidden={i !== 0}
          set:html={panels[i]}
        />
      ))
    }
  </div>
</div>
<script>
  document.querySelectorAll('.js-tabs').forEach((root) => {
    const tabs = [...root.querySelectorAll('[role="tab"]')] as HTMLElement[];
    const panels = [...root.querySelectorAll('[role="tabpanel"]')] as HTMLElement[];
    function select(i: number, focus = false) {
      tabs.forEach((t, j) => {
        const active = j === i;
        t.setAttribute('aria-selected', String(active));
        t.tabIndex = active ? 0 : -1;
        if (active && focus) t.focus();
      });
      panels.forEach((p, j) => (p.hidden = j !== i));
    }
    tabs.forEach((t, i) => {
      t.addEventListener('click', () => select(i));
      t.addEventListener('keydown', (e: KeyboardEvent) => {
        const last = tabs.length - 1;
        if (e.key === 'ArrowRight') select(i === last ? 0 : i + 1, true);
        else if (e.key === 'ArrowLeft') select(i === 0 ? last : i - 1, true);
        else if (e.key === 'Home') {
          e.preventDefault();
          select(0, true);
        } else if (e.key === 'End') {
          e.preventDefault();
          select(last, true);
        }
      });
    });
  });
</script>
