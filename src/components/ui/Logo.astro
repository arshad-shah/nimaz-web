---
import fg from '../../assets/nimaz-foreground.webp';
import { Image } from 'astro:assets';
interface Props {
  size?: number;
  withWord?: boolean;
}
const { size = 32, withWord = true } = Astro.props;
---

<span class="inline-flex items-center gap-2.5">
  <span
    class="grid place-items-center overflow-hidden bg-[var(--c-primary)]"
    style={`width:${size}px;height:${size}px;border-radius:22%`}
  >
    <Image src={fg} alt={withWord ? '' : 'Nimaz'} width={size} height={size} />
  </span>
  {withWord && <span class="font-display text-lg font-bold">Nimaz</span>}
</span>
