---
interface Props {
  class?: string;
}
const { class: cls = '' } = Astro.props;
---

<span
  class:list={[
    'inline-flex items-center gap-1.5 rounded-full bg-[var(--c-tint-primary-bg)] px-3 py-1 text-xs font-semibold tracking-wide text-[var(--c-tint-primary-fg)] uppercase',
    cls,
  ]}><slot /></span
>
