---
interface Item {
  summary: string;
  body: string;
}
interface Props {
  items: Item[];
}
const { items } = Astro.props;
---

<div
  class="divide-y divide-[var(--outline)] rounded-2xl border border-[var(--outline)] bg-[var(--surface)]"
>
  {
    items.map((item) => (
      <details class="group p-5">
        <summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-semibold">
          <span>{item.summary}</span>
          <svg
            class="size-5 shrink-0 transition-transform group-open:rotate-180"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
          >
            <path d="m6 9 6 6 6-6" />
          </svg>
        </summary>
        <p class="mt-3 text-sm leading-relaxed text-[var(--muted)]">{item.body}</p>
      </details>
    ))
  }
</div>
