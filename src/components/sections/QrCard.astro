---
import { qrSvg } from '../../lib/qr';
import Icon from '../ui/Icon.astro';
import { PLAY_STORE_URL, site } from '../../data/site';

const svg = await qrSvg(PLAY_STORE_URL, {
  logo: { href: '/icon-192.png', modules: 8 },
});

const trust = ['Free', 'No ads', 'No tracking'];
---

<div class="rounded-2xl border border-[var(--outline)] bg-[var(--surface)] p-5">
  <div class="flex items-center gap-5">
    <div
      class="size-32 shrink-0 text-[var(--text)] sm:size-36"
      role="img"
      aria-label="QR code linking to the Nimaz app on Google Play"
      set:html={svg}
    />
    <div>
      <h2 class="text-lg font-bold">Scan to download</h2>
      <p class="mt-1 text-sm text-[var(--muted)]">
        Point your phone&rsquo;s camera at the code to open Nimaz on Google Play &mdash; no typing,
        no searching.
      </p>
      <p class="mt-2 text-xs text-[var(--muted)]">Requires {site.app.minOs}.</p>
      <ul class="mt-3 flex flex-wrap gap-1.5">
        {
          trust.map((t) => (
            <li class="inline-flex items-center gap-1 rounded-full bg-[var(--c-tint-primary-bg)] px-2.5 py-1 text-xs font-semibold text-[var(--c-tint-primary-fg)]">
              <Icon name="check" size={13} />
              {t}
            </li>
          ))
        }
      </ul>
    </div>
  </div>
  <p
    class="mt-4 flex items-center gap-2 border-t border-[var(--outline)] pt-3 text-xs text-[var(--muted)]"
  >
    <Icon name="scan-line" size={15} />
    Takes you straight to the official Google Play listing.
  </p>
</div>
