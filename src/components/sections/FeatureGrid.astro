---
import Container from '../ui/Container.astro';
import Card from '../ui/Card.astro';
import Icon from '../ui/Icon.astro';
import SectionHeading from '../ui/SectionHeading.astro';
import { features } from '../../data/features';
interface Props {
  limit?: number;
  heading?: boolean;
  cardLevel?: 'h2' | 'h3';
  /** Show a "see all N" link when `limit` hides some of the catalogue. */
  more?: boolean;
}
const { limit, heading = false, cardLevel = 'h3', more = false } = Astro.props;
const CardTitle = cardLevel;
const items = limit ? features.slice(0, limit) : features;
const hidden = features.length - items.length;
const tint: Record<string, string> = {
  primary: 'bg-[var(--c-tint-primary-bg)] text-[var(--c-tint-primary-fg)]',
  gold: 'bg-[var(--c-tint-gold-bg)] text-[var(--c-tint-gold-fg)]',
  purple: 'bg-[var(--c-tint-purple-bg)] text-[var(--c-tint-purple-fg)]',
};
---

<section class="py-14">
  <Container>
    {
      heading && (
        <SectionHeading eyebrow="Everything in one place" title="A complete Islamic companion" />
      )
    }
    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {
        items.map((f) => (
          <Card>
            <span class:list={['mb-4 grid size-11 place-items-center rounded-xl', tint[f.accent]]}>
              <Icon name={f.icon} size={22} />
            </span>
            <CardTitle class="text-base font-bold">{f.title}</CardTitle>
            <p class="mt-1.5 text-sm leading-relaxed text-[var(--muted)]">{f.body}</p>
          </Card>
        ))
      }
    </div>
    {
      more && hidden > 0 && (
        <p class="mt-8 text-center text-sm text-[var(--muted)]">
          {/* --c-tint-primary-fg, not --c-primary: the brand teal is only 2.38:1 on the page
              background and fails WCAG AA at this size. This token is the darker/lighter
              per-theme pair meant for text. */}
          <a href="/features" class="font-semibold text-[var(--c-tint-primary-fg)] hover:underline">
            See all {features.length} features
          </a>{' '}
          — trackers, tasbih, duas, zakat, khatam plans, widgets and more.
        </p>
      )
    }
  </Container>
</section>
