---
import Base from '../layouts/Base.astro';
import Hero from '../components/sections/Hero.tsx';
import FeatureGrid from '../components/sections/FeatureGrid.tsx';
import StatsStrip from '../components/sections/StatsStrip.tsx';
import DeveloperMessage from '../components/sections/DeveloperMessage.tsx';
import FaqSection from '../components/islands/FaqSection.tsx';
import PrayerWidget from '../components/islands/PrayerWidget.tsx';
import { faqs } from '../data/faq';

const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---

<Base path="/">
  <Hero><PrayerWidget client:load slot="widget" /></Hero>
  <FeatureGrid limit={6} />
  <StatsStrip />
  <DeveloperMessage />
  <FaqSection client:idle items={faqs} />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(faqLd)} />
</Base>
