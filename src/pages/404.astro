---
import Base from '../layouts/Base.astro';
import Container from '../components/ui/Container.astro';
import Button from '../components/ui/Button.astro';
---

<Base title="Page not found" path="/404">
  <Container class="grid min-h-[60vh] place-items-center py-20 text-center">
    <div>
      <svg
        width="96"
        height="96"
        viewBox="0 0 96 96"
        fill="none"
        class="mx-auto text-[var(--c-primary)]"
        aria-hidden="true"
      >
        <circle cx="48" cy="48" r="40" stroke="currentColor" stroke-width="3"></circle>
        <path
          d="M30 60c6-10 30-10 36 0"
          stroke="currentColor"
          stroke-width="3"
          stroke-linecap="round"></path>
        <circle cx="36" cy="40" r="3" fill="currentColor"></circle><circle
          cx="60"
          cy="40"
          r="3"
          fill="currentColor"></circle>
      </svg>
      <h1 class="mt-6 text-3xl font-extrabold">Page not found</h1>
      <p class="mt-2 text-[var(--muted)]">The page you're looking for doesn't exist.</p>
      <div class="mt-6"><Button href="/">Back to home</Button></div>
    </div>
  </Container>
</Base>
