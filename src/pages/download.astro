---
import Base from '../layouts/Base.astro';
import Container from '../components/ui/Container.astro';
import Button from '../components/ui/Button.astro';
import Badge from '../components/ui/Badge.astro';
import PhoneFrame from '../components/ui/PhoneFrame.astro';
import QrCard from '../components/sections/QrCard.astro';
import DownloadSteps from '../components/sections/DownloadSteps.astro';
import { site } from '../data/site';
---

<Base
  title="Download"
  description="Download Nimaz for Android — free, no ads, no in-app purchases."
  path="/download"
>
  <Container class="grid items-center gap-12 py-16 lg:grid-cols-[.9fr_1.1fr]">
    <PhoneFrame />
    <div>
      <Badge>Free · No ads · No in-app purchases</Badge>
      <h1 class="mt-4 text-4xl font-extrabold">Download Nimaz today</h1>
      <p class="mt-3 text-[var(--muted)]">
        Rating {site.app.rating} · {site.app.size} · {site.app.minOs} · by {site.developer}
      </p>
      <div class="mt-6"><DownloadSteps /></div>
      <div class="mt-8 flex flex-wrap items-center gap-4">
        <Button href={site.playStoreUrl} target="_blank" rel="noopener noreferrer"
          >Get it on Google Play</Button
        >
      </div>
      <div class="mt-8 max-w-md"><QrCard /></div>
    </div>
  </Container>
</Base>
