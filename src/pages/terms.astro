---
import Base from '../layouts/Base.astro';
import Container from '../components/ui/Container.astro';
import SectionHeading from '../components/ui/SectionHeading.astro';
import Tabs from '../components/ui/Tabs.astro';
import Card from '../components/ui/Card.astro';
import Button from '../components/ui/Button.astro';
import Icon from '../components/ui/Icon.astro';
import { terms } from '../data/terms';
import { site } from '../data/site';
import { experimental_AstroContainer as AstroContainer } from 'astro/container';
import TermsTabPanel from '../components/ui/TermsTabPanel.astro';

// Astro's compiler can't resolve a dynamic `slot={t.id}` produced inside a
// `.map()` (the slot-name expression is hoisted out of the loop scope), so we
// render each tab panel to HTML at build time and hand it to Tabs via `html`.
const container = await AstroContainer.create();
const tabDefs = await Promise.all(
  terms.tabs.map(async (t) => ({
    id: t.id,
    label: t.title,
    html: await container.renderToString(TermsTabPanel, { props: { tab: t } }),
  })),
);
---

<Base
  title="Terms & Conditions"
  description="The terms of use for the Nimaz application."
  path="/terms"
>
  <Container class="py-14">
    <SectionHeading as="h1" eyebrow={`Effective · ${terms.effective}`} title="Terms & Conditions">
      <p class="mt-3 max-w-2xl text-[var(--muted)]">
        Understanding the terms of use for Nimaz helps ensure a positive experience for everyone.
      </p>
    </SectionHeading>

    <Tabs tabs={tabDefs} />

    <div class="mt-12 grid gap-4 sm:grid-cols-2">
      <Card>
        <h2 class="flex items-center gap-2 text-base font-bold text-[var(--c-accent-text)]">
          <Icon name="circle-check" size={18} />Permitted uses
        </h2>
        <ul class="mt-3 space-y-3 text-sm">
          {
            terms.permitted.map((p) => (
              <li>
                <span class="font-semibold">{p.heading}</span> —{' '}
                <span class="text-[var(--muted)]">{p.body}</span>
              </li>
            ))
          }
        </ul>
      </Card>
      <Card>
        <h2 class="flex items-center gap-2 text-base font-bold text-[var(--c-error)]">
          <Icon name="circle-x" size={18} />Prohibited uses
        </h2>
        <ul class="mt-3 space-y-3 text-sm">
          {
            terms.prohibited.map((p) => (
              <li>
                <span class="font-semibold">{p.heading}</span> —{' '}
                <span class="text-[var(--muted)]">{p.body}</span>
              </li>
            ))
          }
        </ul>
      </Card>
    </div>

    <div class="mt-10 flex flex-wrap gap-3">
      <Button
        href="/legal/Terms-and-Conditions.pdf"
        variant="ghost"
        target="_blank"
        rel="noopener noreferrer">Download complete terms (PDF)</Button
      >
      <Button href={`mailto:${site.email}`}>Contact developer</Button>
    </div>
  </Container>
</Base>
