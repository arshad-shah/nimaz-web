---
import '@fontsource-variable/outfit';
import '@fontsource-variable/plus-jakarta-sans';
import '../styles/page.css';
import { htmlAttributes } from '@arshad-shah/cynosure/astro';
import Seo from '../components/layout/Seo.astro';
import Header from '../components/layout/Header.tsx';
import Footer from '../components/layout/Footer.tsx';
interface Props {
  title?: string;
  description?: string;
  path?: string;
}
const { title, description, path } = Astro.props;
---

<!doctype html>
<html lang="en" {...htmlAttributes({ mode: 'system' })}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" href="/favicon-32.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#14b8a6" />
    <Seo title={title} description={description} path={path} />
  </head>
  <body>
    <Header client:load path={Astro.url.pathname} />
    <main id="main"><slot /></main>
    <Footer year={new Date().getFullYear()} />
  </body>
</html>
